# Copy this file to ".env" (which is git-ignored) and fill in your values.
#   cp env.example .env
#
# Get these from App Store Connect → Users and Access → Integrations → App Store Connect API.

# The Key ID shown next to the key you generated (e.g. ABC123XYZ)
ASC_KEY_ID=

# The Issuer ID shown at the top of the Keys page (a UUID)
ASC_ISSUER_ID=

# Optional: absolute path to the .p8. Defaults to the AuthKey_*.p8 in ios/private_keys/
# ASC_KEY_PATH=

# Optional per-release overrides
# APP_VERSION=1.0.44
# RELEASE_NOTES=New comments feature and bug fixes.
